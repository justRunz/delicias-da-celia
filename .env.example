# Copiez ce fichier en `.env` et renseignez les valeurs.
# Ces variables sont aussi à déclarer dans Vercel :
# Project Settings → Environment Variables.

# Envoi par Cloudflare Email Service (API REST).
# Identifiant du compte Cloudflare (tableau de bord, colonne de droite de la page du domaine).
CLOUDFLARE_ACCOUNT_ID=

# Jeton API avec la permission « Email Sending: Edit » (My Profile → API Tokens).
CLOUDFLARE_API_TOKEN=

# Expéditeur : une adresse du domaine déclaré dans Email Sending.
EMAIL_FROM=site@asdelicias-dacelia.com

# Destinataire : doit être une adresse de destination vérifiée dans Email Routing
# (envoi gratuit, sans offre Workers payante).
EMAIL_TO=asdelicias.dacelia@gmail.com
