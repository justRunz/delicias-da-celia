---
import Analytics from "@vercel/analytics/astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/fraunces/full-italic.css";
import "../styles/global.css";
import { company } from "../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Structured data: WebSite → Google shows the name instead of the domain;
// Bakery → local listing (address, phone, social links).
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", name: company.name, url: Astro.site?.href },
    {
      "@type": "Bakery",
      name: company.name,
      url: Astro.site?.href,
      logo: new URL("/apple-touch-icon.png", Astro.site).href,
      telephone: company.phoneHref.replace("tel:", ""),
      address: {
        "@type": "PostalAddress",
        addressLocality: company.place,
        addressRegion: company.city,
        addressCountry: "PT",
      },
      sameAs: [company.facebook, company.instagram],
    },
  ],
};
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Favicon: the header logo (doily + baker), generated from src/assets/logo -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f1ea" />

    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="visually-hidden" href="#conteudo">Saltar para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/motion";
    </script>
    <Analytics />
  </body>
</html>
