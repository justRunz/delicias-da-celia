---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { company, nav, legal } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <a href="/" class="footer__brand" aria-label={`${company.name}, voltar ao início`}>
        <Logo tone="light" />
      </a>

      <nav aria-label="Rodapé">
        <ul role="list" class="footer__nav">
          {nav.map((n) => <li><a class="link-underline" href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer__contact">
        <a class="link-underline" href={company.phoneHref}>{company.phone}</a>
        <span>{company.place}, {company.city}</span>
        <div class="footer__socials">
          <a href={company.instagram} target="_blank" rel="noopener" class="footer__social" aria-label="Instagram">
            <Icon name="instagram" />
          </a>
          <a href={company.facebook} target="_blank" rel="noopener" class="footer__social" aria-label="Facebook">
            <Icon name="facebook" />
          </a>
          <a href={company.whatsapp} target="_blank" rel="noopener" class="footer__social" aria-label="WhatsApp">
            <Icon name="whatsapp" />
          </a>
        </div>
      </div>
    </div>

    <p class="footer__big display" aria-hidden="true">Delícias <em>da Célia</em></p>

    <div class="footer__bottom">
      <span>© {year} {company.name}</span>
      <nav class="footer__legal" aria-label="Informação legal">
        <a class="link-underline" href="/informacao-legal">Informação legal e privacidade</a>
        <a class="link-underline" href={legal.complaints} target="_blank" rel="noopener">Livro de Reclamações</a>
      </nav>
      <span>Feito com carinho em {company.city}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-cocoa);
    color: rgb(247 241 234 / 0.65);
    padding-block: 0 2rem;
    font-size: var(--fs-sm);
    overflow: hidden;
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-top: 3rem;
    border-top: 1px solid rgb(247 241 234 / 0.12);
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .footer__nav a:hover,
  .footer__contact a:hover {
    color: var(--c-on-dark);
  }

  .footer__contact {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer__socials {
    display: flex;
    gap: 0.5rem;
  }

  .footer__social {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(247 241 234 / 0.2);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .footer__social:hover {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-on-dark);
  }

  /* Large watermark name overflowing the bottom of the page */
  .footer__big {
    margin-block: clamp(2.5rem, 6vw, 5rem) 1.5rem;
    font-size: clamp(3.5rem, 13.5vw, 13.5rem);
    line-height: 0.85;
    white-space: nowrap;
    color: rgb(247 241 234 / 0.9);
  }

  .footer__big :global(em),
  .footer__big em {
    color: var(--c-accent-tint);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(247 241 234 / 0.12);
    font-size: var(--fs-xs);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
