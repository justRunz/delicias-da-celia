# Copy this file to `.env` and fill in the values.
# These variables must also be set in Vercel:
# Project Settings → Environment Variables.

# Resend API key (resend.com/api-keys)
RESEND_API_KEY=

# Sender address for form messages.
# Without a verified domain in Resend, use "onboarding@resend.dev". Resend then only sends
# to the Resend account address (create the account with Célia's address).
EMAIL_FROM="As Delícias da Célia <onboarding@resend.dev>"

# Recipient of the messages (Célia's e-mail address).
EMAIL_TO=
