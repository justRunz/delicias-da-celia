---
/**
 * Custom date picker. The iPhone's native calendar lets people pick forbidden days
 * (it ignores `min`), so here today and past days cannot be clicked.
 * The value (YYYY-MM-DD) goes into a hidden `name` field. Earliest possible day is tomorrow.
 */
interface Props {
  id: string;
  name: string;
  label: string;
  describedby?: string;
}
const { id, name, label, describedby } = Astro.props;
---

<div class="dp" data-dp>
  <label class="dp__label" for={id}>{label}</label>
  <button
    type="button"
    id={id}
    class="dp__field"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-describedby={describedby}
    data-dp-toggle
  >
    <span class="dp__value" data-dp-value>Escolher uma data</span>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <rect x="3.5" y="5" width="17" height="15" rx="3" />
      <path d="M3.5 10h17M8 3v4M16 3v4" />
    </svg>
  </button>
  <input type="hidden" name={name} data-dp-input />

  <div class="dp__panel" role="dialog" aria-label="Escolher a data do evento" hidden data-dp-panel>
    <div class="dp__head">
      <button type="button" class="dp__nav" aria-label="Mês anterior" data-dp-prev>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
      </button>
      <p class="dp__month display" aria-live="polite" data-dp-month></p>
      <button type="button" class="dp__nav" aria-label="Mês seguinte" data-dp-next>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </div>
    <div class="dp__weekdays" aria-hidden="true">
      {["S", "T", "Q", "Q", "S", "S", "D"].map((d) => <span>{d}</span>)}
    </div>
    <div class="dp__grid" role="grid" data-dp-grid></div>
    <div class="dp__foot">
      <button type="button" class="dp__clear" data-dp-clear>Sem data</button>
    </div>
  </div>
</div>

<style>
  .dp {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .dp__label {
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .dp__field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.2rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-ink);
    font-size: max(16px, var(--fs-base));
    text-align: left;
    transition: border-color 0.25s, box-shadow 0.25s, background-color 0.25s;
  }

  .dp__field:hover {
    border-color: color-mix(in srgb, var(--c-line) 50%, var(--c-ink-soft));
  }

  .dp__field:focus-visible,
  .dp__field[aria-expanded="true"] {
    outline: none;
    border-color: var(--c-accent);
    background: #fff;
    box-shadow: 0 0 0 4px var(--c-accent-soft);
  }

  .dp__value.is-empty {
    color: var(--c-muted);
  }

  .dp__field svg,
  .dp__nav svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dp__field svg {
    color: var(--c-accent-deep);
  }

  /* --- Calendar --- */
  .dp__panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 20;
    width: min(320px, calc(100vw - 2 * var(--gutter) - 2rem));
    padding: 1rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    background: #fff;
    color: var(--c-ink);
    box-shadow: 0 30px 60px -25px rgb(var(--c-shadow) / 0.45);
    transform-origin: top left;
  }

  .dp__panel[hidden] {
    display: none;
  }

  .dp__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .dp__month {
    font-size: 1.15rem;
  }

  .dp__nav {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background: transparent;
    transition: background-color 0.25s, border-color 0.25s, opacity 0.25s;
  }

  .dp__nav:hover:not(:disabled) {
    border-color: var(--c-brand);
    background: var(--c-accent-soft);
  }

  .dp__nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .dp__weekdays,
  .dp__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 2px;
    text-align: center;
  }

  .dp__weekdays span {
    padding-bottom: 0.4rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--c-muted);
  }

  .dp__grid :global(.dp__day) {
    position: relative;
    aspect-ratio: 1;
    border: 0;
    border-radius: 50%;
    background: transparent;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: var(--c-ink);
    transition: background-color 0.2s, color 0.2s, transform 0.3s var(--ease-spring);
  }

  .dp__grid :global(.dp__day:hover:not(:disabled)) {
    background: var(--c-accent-soft);
  }

  .dp__grid :global(.dp__day:active:not(:disabled)) {
    transform: scale(0.9);
  }

  /* Unavailable days: faded and struck through, not clickable */
  .dp__grid :global(.dp__day:disabled) {
    color: color-mix(in srgb, var(--c-muted) 45%, transparent);
    text-decoration: line-through;
    cursor: not-allowed;
  }

  /* Today: small dot, but not selectable */
  .dp__grid :global(.dp__day.is-today::after) {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 5px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--c-brand);
  }

  .dp__grid :global(.dp__day[aria-selected="true"]) {
    background: var(--c-accent);
    color: var(--c-on-dark);
  }

  .dp__grid :global(.dp__day:focus-visible) {
    outline: 2px solid var(--c-accent);
    outline-offset: 1px;
  }

  .dp__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  .dp__clear {
    padding: 0.35rem 0.6rem;
    border: 0;
    background: none;
    font-size: var(--fs-xs);
    color: var(--c-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  import { gsap } from "gsap";

  const MONTHS = new Intl.DateTimeFormat("pt-PT", { month: "long", year: "numeric" });
  const LONG = new Intl.DateTimeFormat("pt-PT", { weekday: "long", day: "numeric", month: "long" });

  const iso = (d: Date) =>
    `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  const startOfDay = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate());

  document.querySelectorAll<HTMLElement>("[data-dp]").forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>("[data-dp-toggle]")!;
    const valueEl = root.querySelector<HTMLElement>("[data-dp-value]")!;
    const input = root.querySelector<HTMLInputElement>("[data-dp-input]")!;
    const panel = root.querySelector<HTMLElement>("[data-dp-panel]")!;
    const grid = root.querySelector<HTMLElement>("[data-dp-grid]")!;
    const monthEl = root.querySelector<HTMLElement>("[data-dp-month]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-dp-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-dp-next]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const placeholder = valueEl.textContent ?? "";

    // Computed on open, since the page may stay open until the next day
    let today = startOfDay(new Date());
    let first = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);
    let selected: Date | null = null;
    let view = new Date(first.getFullYear(), first.getMonth(), 1);

    const render = (focusDay?: number) => {
      const label = MONTHS.format(view);
      monthEl.textContent = label.charAt(0).toUpperCase() + label.slice(1);
      // No going back before the month of the earliest possible day
      prev.disabled = view <= new Date(first.getFullYear(), first.getMonth(), 1);

      const days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
      const offset = (new Date(view.getFullYear(), view.getMonth(), 1).getDay() + 6) % 7; // Monday first
      grid.replaceChildren();
      for (let i = 0; i < offset; i++) grid.appendChild(document.createElement("span"));
      for (let n = 1; n <= days; n++) {
        const date = new Date(view.getFullYear(), view.getMonth(), n);
        const b = document.createElement("button");
        b.type = "button";
        b.className = "dp__day";
        b.textContent = String(n);
        b.dataset.day = String(n);
        b.setAttribute("aria-label", LONG.format(date));
        if (date < first) b.disabled = true;
        if (date.getTime() === today.getTime()) b.classList.add("is-today");
        const isSel = !!selected && date.getTime() === selected.getTime();
        b.setAttribute("aria-selected", String(isSel));
        b.tabIndex = -1;
        grid.appendChild(b);
      }
      // Only one day is reachable with Tab: the selected one, otherwise the earliest possible
      const target =
        grid.querySelector<HTMLButtonElement>(`[data-day="${focusDay ?? ""}"]:not(:disabled)`) ??
        grid.querySelector<HTMLButtonElement>('[aria-selected="true"]') ??
        grid.querySelector<HTMLButtonElement>(".dp__day:not(:disabled)");
      if (target) target.tabIndex = 0;
      if (focusDay && target) target.focus();
    };

    const open = () => {
      today = startOfDay(new Date());
      first = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);
      const base = selected ?? first;
      view = new Date(base.getFullYear(), base.getMonth(), 1);
      render();
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      if (!reduced) gsap.fromTo(panel, { opacity: 0, y: -8, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.35, ease: "back.out(1.6)" });
      grid.querySelector<HTMLButtonElement>('[tabindex="0"]')?.focus();
    };

    const close = (refocus = true) => {
      if (panel.hidden) return;
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      if (refocus) toggle.focus();
    };

    const choose = (date: Date | null, refocus = true) => {
      selected = date;
      input.value = date ? iso(date) : "";
      const text = date ? LONG.format(date) : placeholder;
      valueEl.textContent = text.charAt(0).toUpperCase() + text.slice(1);
      valueEl.classList.toggle("is-empty", !date);
      close(refocus);
    };

    valueEl.classList.add("is-empty");
    toggle.addEventListener("click", () => (panel.hidden ? open() : close()));
    prev.addEventListener("click", () => {
      view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
      render();
    });
    next.addEventListener("click", () => {
      view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
      render();
    });
    grid.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".dp__day");
      if (!b || b.disabled) return;
      choose(new Date(view.getFullYear(), view.getMonth(), Number(b.dataset.day)));
    });
    root.querySelector("[data-dp-clear]")!.addEventListener("click", () => choose(null));

    // Keyboard: arrows to move, Escape to close
    panel.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      const cur = (e.target as HTMLElement).closest<HTMLButtonElement>(".dp__day");
      const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[e.key];
      if (!cur || !step) return;
      e.preventDefault();
      const date = new Date(view.getFullYear(), view.getMonth(), Number(cur.dataset.day) + step);
      if (date < first) return;
      if (date.getMonth() !== view.getMonth()) view = new Date(date.getFullYear(), date.getMonth(), 1);
      render(date.getDate());
    });

    // Click outside closes
    document.addEventListener("pointerdown", (e) => {
      if (!root.contains(e.target as Node)) close(false);
    });

    // Reset along with the form
    root.closest("form")?.addEventListener("reset", () => choose(null, false));
  });
</script>
