---
/**
 * En-tête des pages intérieures : fil d'Ariane + grand titre à gauche, texte à droite.
 * Slots : default = titre (contenu du h1), "aside" = texte de droite.
 */
interface Props {
  current: string;
}
const { current } = Astro.props;
---

<section class="phero">
  <div class="container phero__grid">
    <div>
      <nav class="crumbs" aria-label="Caminho" data-reveal="up">
        <a href="/" class="link-underline">Início</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{current}</span>
      </nav>
      <h1 class="display" data-reveal="words"><slot /></h1>
    </div>
    <div class="phero__aside" data-reveal="up">
      <slot name="aside" />
    </div>
  </div>
</section>

<style>
  .phero {
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 4.5rem));
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .phero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }

  .crumbs [aria-current] {
    color: var(--c-ink);
  }

  h1 {
    margin-top: 2rem;
    font-size: var(--fs-3xl);
    max-width: 12ch;
  }

  .phero__aside {
    font-size: var(--fs-lg);
    line-height: 1.55;
    color: var(--c-ink-soft);
    max-width: 46ch;
  }

  @media (max-width: 900px) {
    .phero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
