# Copy this file to `.env` and fill in the values.
# These variables must also be set in Vercel:
# Project Settings → Environment Variables.

# Sending through Cloudflare Email Service (REST API).
# Cloudflare account ID (dashboard, right-hand column of the domain page).
CLOUDFLARE_ACCOUNT_ID=

# API token with the "Email Sending: Edit" permission (My Profile → API Tokens).
CLOUDFLARE_API_TOKEN=

# Sender: an address on the domain set up in Email Sending.
EMAIL_FROM=site@asdelicias-dacelia.com

# Recipient: must be a verified destination address in Email Routing
# (free sending, no paid Workers plan needed).
EMAIL_TO=asdelicias.dacelia@gmail.com
