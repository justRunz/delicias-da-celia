---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { company } from "../data/site";
---

<!-- Page 404 : le « 0 » est un napperon ovale, festonné comme celui du logo. -->
<Base title={`Página não encontrada · ${company.name}`} description="Esta página não existe ou mudou de sítio.">
  <section class="nf">
    <div class="container nf__inner">
      <p class="eyebrow" data-reveal="up">Erro 404</p>

      <div class="nf__code display" aria-hidden="true">
        <span>4</span>
        <span class="nf__plate">
          <svg class="nf__lace" viewBox="0 0 130 180">
            <ellipse class="nf__scallops" cx="65" cy="90" rx="57" ry="82" pathLength="100" />
            <ellipse class="nf__ring" cx="65" cy="90" rx="48" ry="73" />
            <ellipse class="nf__holes" cx="65" cy="90" rx="48" ry="73" pathLength="100" />
          </svg>
        </span>
        <span>4</span>
      </div>

      <h1 class="display nf__title" data-reveal="words">Alguém comeu <em>esta página.</em></h1>
      <p class="lead nf__lead" data-reveal="up">
        A página que procura não existe ou mudou de sítio. Mas a montra continua cheia. Escolha por onde quer
        continuar.
      </p>

      <div class="nf__actions" data-reveal="up">
        <a href="/" class="btn btn--accent">Voltar ao início <Icon name="arrow-right" /></a>
        <a href="/criacoes" class="btn btn--ghost">Ver as criações</a>
        <a href="/precario" class="btn btn--ghost">Preçário</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: var(--section);
    text-align: center;
  }

  .nf__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nf__code {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    margin-top: 1.5rem;
    font-size: clamp(7rem, 4rem + 14vw, 15rem);
    line-height: 1;
    color: var(--c-ink);
  }

  .nf__plate {
    display: block;
    width: 0.62em;
    aspect-ratio: 130 / 180;
  }

  .nf__lace {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke-linecap: round;
  }

  /* Festons du bord extérieur */
  .nf__scallops {
    stroke: var(--c-brand);
    stroke-width: 11;
    stroke-dasharray: 0 3.125;
  }

  /* Corps du 0 */
  .nf__ring {
    stroke: var(--c-brand);
    stroke-width: 20;
  }

  /* Petits trous de dentelle qui défilent le long du 0 */
  .nf__holes {
    stroke: var(--c-bg);
    stroke-width: 5;
    stroke-dasharray: 0 4.1667;
    animation: lace 40s linear infinite;
  }

  .nf__title {
    margin-top: 1.5rem;
    font-size: var(--fs-2xl);
  }

  .nf__lead {
    margin: 1.25rem auto 0;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @keyframes lace {
    to { stroke-dashoffset: -100; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf__holes {
      animation: none;
    }
  }
</style>
