# Copiez ce fichier en `.env` et renseignez les valeurs.
# Ces variables sont aussi à déclarer dans Vercel :
# Project Settings → Environment Variables.

# Clé API Resend (resend.com/api-keys)
RESEND_API_KEY=

# Expéditeur des messages du formulaire.
# Sans domaine vérifié dans Resend, utiliser « onboarding@resend.dev » : Resend n'envoie
# alors qu'à l'adresse du compte Resend (créer le compte avec l'adresse de la Célia).
EMAIL_FROM="As Delícias da Célia <onboarding@resend.dev>"

# Destinataire des messages (l'adresse e-mail de la Célia).
EMAIL_TO=
