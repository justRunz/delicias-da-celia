---
import { Image } from "astro:assets";
import { company } from "../../data/site";
import stand from "../../assets/photos/banca.jpg";
import breads from "../../assets/photos/paes-caseiros.jpg";
---

<section class="about section" id="sobre">
  <div class="about__inner container">
    <div class="about__visual">
      <figure class="about__photo" data-reveal="clip">
        <div class="about__parallax" data-parallax="12">
          <Image
            src={stand}
            alt="A banca das Delícias da Célia numa feira, com doces embalados e a faixa cor-de-rosa"
            widths={[480, 720, 960]}
            sizes="(max-width: 900px) 92vw, 45vw"
          />
        </div>
      </figure>
      <figure class="about__detail" data-reveal="pop">
        <Image src={breads} alt="" widths={[240, 400]} sizes="200px" />
      </figure>
    </div>

    <div class="about__text">
      <p class="eyebrow" data-reveal="up">Quem somos</p>
      <h2 class="about__title display" data-reveal="words">
        Uma cozinha de casa, <em>receitas de sempre.</em>
      </h2>
      <div class="about__prose" data-reveal="up">
        <p>
          Somos uma pastelaria caseira em {company.place}, às portas de {company.city}. Amassamos, recheamos,
          cozemos e decoramos tudo na nossa cozinha.
        </p>
        <p>
          É por isso que cada bolo é diferente: o tema, os sabores e o tamanho são combinados consigo. E o pão com
          chouriço sai do forno no próprio dia.
        </p>
      </div>

      <dl class="about__stats" data-reveal="stagger">
        <div>
          <dt>Recomendam</dt>
          <dd class="display"><span data-count={company.rating.percent}>{company.rating.percent}</span><small>%</small></dd>
        </div>
        <div>
          <dt>Avaliações no Facebook</dt>
          <dd class="display"><span data-count={company.rating.count}>{company.rating.count}</span></dd>
        </div>
        <div>
          <dt>Seguidores</dt>
          <dd class="display">
            <span data-count={company.followers} data-decimals="1">{String(company.followers).replace(".", ",")}</span><small>mil</small>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: center;
  }

  .about__visual {
    position: relative;
    padding-bottom: 12%;
  }

  .about__photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    background: var(--c-flour);
  }

  .about__parallax {
    position: absolute;
    inset: -8% 0;
  }

  .about__parallax :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__detail {
    position: absolute;
    right: -6%;
    bottom: 0;
    width: 36%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    border: 6px solid var(--c-bg);
    box-shadow: 0 24px 48px -20px rgb(var(--c-shadow) / 0.4);
  }

  .about__detail :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .about__title {
    font-size: var(--fs-2xl);
    max-width: 14ch;
  }

  .about__prose {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--c-ink-soft);
    max-width: 52ch;
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin: 1rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--c-line);
  }

  .about__stats dt {
    font-size: var(--fs-xs);
    color: var(--c-muted);
    letter-spacing: 0.04em;
  }

  .about__stats dd {
    margin: 0.35rem 0 0;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .about__stats small {
    margin-left: 0.15em;
    font-size: 0.45em;
    font-style: italic;
    color: var(--c-accent-deep);
  }

  @media (max-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr;
    }

    .about__detail {
      right: -2%;
    }
  }

  @media (max-width: 480px) {
    .about__stats {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
