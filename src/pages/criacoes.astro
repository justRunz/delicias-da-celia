---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Lightbox from "../components/Lightbox.astro";
import ContactCta from "../components/ContactCta.astro";
import { categories, creations, featured, imageOf } from "../data/creations";

const labelOf = new Map<string, string>(categories.map((c) => [c.id, c.label]));

// « Tudo » : les mises en avant d'abord, puis le reste dans l'ordre des catégories
const catRank = (id: string) => categories.findIndex((c) => c.id === id);
const rank = (file: string) => (featured.includes(file) ? featured.indexOf(file) : featured.length);
const ordered = [...creations].sort((a, b) => rank(a.file) - rank(b.file) || catRank(a.category) - catRank(b.category));

const items = await Promise.all(
  ordered.map(async (c) => {
    const src = imageOf(c.file);
    const full = await getImage({ src, width: Math.min(src.width, 1600), format: "webp" });
    const ratio = src.width / src.height;
    // Forme de la vignette selon l'orientation de la photo
    const shape = ratio > 1.55 ? "wide" : ratio < 0.85 ? "tall" : "std";
    return { ...c, src, full: full.src, shape, label: labelOf.get(c.category) ?? "" };
  }),
);

const filters = categories.map((c) => ({ ...c, count: creations.filter((x) => x.category === c.id).length }));
---

<Base
  title="Criações · As Delícias da Célia, bolos e doces por encomenda"
  description={`As nossas criações: bolos de aniversário para meninas, meninos e adultos, bolos de batizado e comunhão, bolachas decoradas, cupcakes, salgados e catering em Santarém.`}
>
  <PageHero current="Criações">
    Cada bolo, <em>uma história.</em>
    <p slot="aside">
      Anos de encomendas feitas à mão, com carinho: aniversários, batizados, bolachas decoradas, doçaria
      tradicional e mesas de festa. Escolha uma categoria para se inspirar.
    </p>
  </PageHero>

  <section class="works" data-works>
    <div class="container">
      <div class="filters" data-reveal="up">
        <div class="filters__scroll" role="group" aria-label="Filtrar por categoria" data-filters>
          <button class="chip is-active" data-filter="all" aria-pressed="true">
            Tudo <span>{creations.length}</span>
          </button>
          {filters.map((f) => (
            <button class="chip" data-filter={f.id} aria-pressed="false">
              {f.label} <span>{f.count}</span>
            </button>
          ))}
        </div>
      </div>

      <ul class="grid" role="list" data-lightbox-group data-grid>
        {items.map((it, i) => (
          <li class:list={["cell", `cell--${it.shape}`]} data-category={it.category}>
            <a href={it.full} data-lightbox data-caption={it.title} class="cell__link">
              <Image
                src={it.src}
                alt={it.title}
                widths={[360, 600, 900]}
                sizes="(max-width: 640px) 50vw, (max-width: 1000px) 33vw, 25vw"
                loading={i < 8 ? "eager" : "lazy"}
              />
              <span class="cell__info">
                <span class="cell__tag">{it.label}</span>
                <span class="cell__title">{it.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="empty" hidden data-empty>Ainda não há fotografias nesta categoria.</p>

      <div class="more" data-reveal="up">
        <p>Há muitas mais na nossa página do Facebook.</p>
        <a href="https://www.facebook.com/asdeliciasdacelia.pt/photos_albums" class="btn btn--ghost" target="_blank" rel="noopener">
          Ver os álbuns no Facebook
        </a>
      </div>
    </div>
  </section>

  <ContactCta />
  <Lightbox />
</Base>

<style>
  .works {
    padding-bottom: var(--section);
  }

  /* --- Filtres --- */
  .filters {
    position: sticky;
    top: calc(var(--header-h) - 1px);
    z-index: 5;
    margin-inline: calc(var(--gutter) * -1);
    padding: 1rem var(--gutter);
    background: var(--c-bg);
    transition: top 0.5s var(--ease-out);
  }

  /* Quand l'en-tête se cache (ordinateur), la barre remonte tout en haut */
  :global(html:has(.header.is-hidden)) .filters {
    top: 0;
  }

  .filters__scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    /* Fondu à droite : indique que la liste continue */
    mask-image: linear-gradient(90deg, #000 calc(100% - 4rem), transparent);
  }

  .filters__scroll.is-end {
    mask-image: none;
  }

  .filters__scroll::-webkit-scrollbar {
    display: none;
  }

  /* --- Grille --- */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: clamp(150px, 16vw, 240px);
    grid-auto-flow: dense;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  .cell--tall {
    grid-row: span 2;
  }

  .cell--wide {
    grid-column: span 2;
  }

  .cell.is-hidden {
    display: none;
  }

  .cell__link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--c-flour);
    cursor: zoom-in;
    isolation: isolate;
  }

  .cell__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  /* Dégradé cacao + titre qui montent au survol */
  .cell__info {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 2.5rem 1rem 0.9rem;
    background: linear-gradient(to top, rgb(43 29 24 / 0.75), transparent);
    color: var(--c-on-dark);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s, transform 0.6s var(--ease-out);
  }

  .cell__tag {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--c-brand);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .cell__title {
    font-family: var(--f-display);
    font-size: 1.05rem;
    line-height: 1.15;
    font-variation-settings: "opsz" 48, "SOFT" 100;
  }

  @media (hover: hover) {
    .cell__link:hover :global(img) {
      transform: scale(1.06);
    }

    .cell__link:hover .cell__info {
      opacity: 1;
      transform: none;
    }
  }

  .empty {
    padding: 4rem 0;
    text-align: center;
    color: var(--c-muted);
  }

  .more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    text-align: center;
    color: var(--c-ink-soft);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 42vw;
      gap: 0.6rem;
    }

    .cell__link {
      border-radius: 14px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(Flip, ScrollTrigger);

  const root = document.querySelector<HTMLElement>("[data-works]")!;
  const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cells = [...root.querySelectorAll<HTMLElement>(".cell")];
  const empty = root.querySelector<HTMLElement>("[data-empty]")!;
  const grid = root.querySelector<HTMLElement>("[data-grid]")!;
  const bar = root.querySelector<HTMLElement>("[data-filters]")!;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const apply = (filter: string, animate: boolean) => {
    const state = Flip.getState(cells);
    gsap.killTweensOf(grid);
    gsap.set(grid, { clearProps: "height" });
    const fromHeight = grid.offsetHeight;
    let visible = 0;
    cells.forEach((c) => {
      const show = filter === "all" || c.dataset.category === filter;
      c.classList.toggle("is-hidden", !show);
      if (show) visible++;
    });
    chips.forEach((ch) => {
      const on = ch.dataset.filter === filter;
      ch.classList.toggle("is-active", on);
      ch.setAttribute("aria-pressed", String(on));
    });
    empty.hidden = visible > 0;

    if (animate && !reduced) {
      // Pendant l'animation les photos sortent du flux : on fige la hauteur de la grille
      // (la plus grande des deux) pour que la suite de la page ne remonte pas par-dessus.
      const toHeight = grid.offsetHeight;
      gsap.set(grid, { height: Math.max(fromHeight, toHeight) });
      Flip.from(state, {
        duration: 0.7,
        ease: "expo.inOut",
        absolute: true,
        stagger: 0.012,
        onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.7, ease: "back.out(1.4)" }),
        onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.85, duration: 0.35 }),
        onComplete: () => {
          gsap.to(grid, {
            height: toHeight,
            duration: 0.45,
            ease: "power2.inOut",
            clearProps: "height",
            onComplete: () => ScrollTrigger.refresh(),
          });
        },
      });
    } else {
      ScrollTrigger.refresh();
    }

    // Lien partageable : /criacoes?categoria=batizados
    const url = new URL(location.href);
    if (filter === "all") url.searchParams.delete("categoria");
    else url.searchParams.set("categoria", filter);
    history.replaceState(history.state, "", url);
  };

  chips.forEach((ch) =>
    ch.addEventListener("click", () => {
      if (ch.classList.contains("is-active")) return;
      apply(ch.dataset.filter!, true);
      // Ramène le haut de la grille sous la barre de filtres si on est descendu loin
      const top = grid.getBoundingClientRect().top;
      if (top < 0) window.lenis?.scrollTo(grid, { offset: -(bar.getBoundingClientRect().bottom + 16), duration: 1 });
      // Fait défiler la puce choisie dans la barre (mobile)
      bar.scrollTo({ left: ch.offsetLeft - bar.clientWidth / 2 + ch.offsetWidth / 2, behavior: "smooth" });
    }),
  );

  // Retire le fondu quand on arrive au bout de la liste des filtres
  const updateEnd = () => bar.classList.toggle("is-end", bar.scrollLeft + bar.clientWidth >= bar.scrollWidth - 4);
  bar.addEventListener("scroll", updateEnd, { passive: true });
  window.addEventListener("resize", updateEnd);
  updateEnd();

  const initial = new URLSearchParams(location.search).get("categoria");
  if (initial && chips.some((c) => c.dataset.filter === initial)) {
    apply(initial, false);
    // Arrivée par un lien de catégorie : la puce active est rendue visible dans la barre
    const active = chips.find((c) => c.dataset.filter === initial)!;
    bar.scrollLeft = active.offsetLeft - bar.clientWidth / 2 + active.offsetWidth / 2;
    updateEnd();
  }

  // Apparition en cascade des premières photos
  if (!reduced) {
    gsap.from(
      cells.filter((c) => !c.classList.contains("is-hidden")).slice(0, 12),
      { opacity: 0, y: 40, scale: 0.96, duration: 1, ease: "expo.out", stagger: 0.05, delay: 0.35 },
    );
  }
</script>
